NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# memory permite desenvolver sem MongoDB. O responsavel pelo banco troca para mongo
# quando implementar src/repositories/mongo/createMongoRepositories.js.
DATA_DRIVER=memory

# Use uma string longa e aleatoria. Em producao, o backend recusa a chave de exemplo.
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=8h
COOKIE_NAME=redae_token
COOKIE_MAX_AGE_MS=28800000

# Google Identity Services - Web Client ID (nao e Client Secret).
GOOGLE_CLIENT_ID=

# Gemini API - a chave fica somente neste .env e nunca no frontend/GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=90000

MAX_PROFILE_PHOTO_MB=3
